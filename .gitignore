# Private environment files; retain safe configuration templates
.env
.env.*
*.env
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
*.keystore

# Local Python environments, dependency caches and generated bytecode
.venv/
.venv-*/
venv/
env/
.uv-cache/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.Python

# Build and distribution output (uv.lock is intentionally tracked)
build/
dist/
.eggs/
*.egg
*.whl

# Test, coverage and tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
junit.xml
.artifacts/
test-results/

# Logs, local database dumps and temporary files
*.log
*.pid
*.pid.lock
*.tmp
*.temp
*.bak
*.swp
*.swo
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz
*.zip
*.tar
*.tgz

# Editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
