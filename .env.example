# ===========================================================================
# SKANDA AI — backend environment
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# Nothing in this file is exposed to the browser.
# ===========================================================================

# --- Neon database ----------------------------------------------------------
DATABASE_URL=postgresql://your-user:your-password@your-host.neon.tech/neondb?ssl=verify-full

# --- Shared demo login -----------------------------------------------------
# Explicit opt-in. Everyone entering the demo uses one shared account.
# This is not customer signup or production authentication.
DEMO_AUTH_ENABLED=false
# Generate once: python -c "import secrets; print(secrets.token_urlsafe(48))"
DEMO_AUTH_SECRET=
DEMO_AUTH_EMAIL=demo@skanda.local
DEMO_AUTH_NAME="Demo user"
DEMO_AUTH_TTL_HOURS=8

# --- Real customer accounts --------------------------------------------------
# Signs the session token every signed-up customer gets at /api/auth/signup
# and /api/auth/login. Unset -> a random key generated per process, which
# signs everyone out on every restart. Generate the same way as the demo
# secret above, and keep it persistent and secret in production.
ACCOUNT_AUTH_SECRET=
ACCOUNT_AUTH_TTL_HOURS=336
PASSWORD_MIN_LENGTH=8
LOGIN_LOCKOUT_THRESHOLD=6
LOGIN_LOCKOUT_MINUTES=15
AUTH_IP_LIMIT_PER_MINUTE=10

# --- Firecrawl -------------------------------------------------------------
# https://firecrawl.dev -> Dashboard -> API Keys
FIRECRAWL_API_KEY=fc-your-key-here

# --- Gemma (Phase 2 AI engine) ---------------------------------------------
# Gemma is open-weights and served by many hosts, so the endpoint, the model id
# and the request dialect are all configurable. Pick ONE block below, paste it
# in, then run `python scripts/check_gemma.py` to confirm it answers.
#
# GEMMA_API_FLAVOR selects the request dialect:
#   google -> POST {GEMMA_API_URL}/models/{model}:generateContent
#             (and :streamGenerateContent?alt=sse), key in x-goog-api-key
#   openai -> POST {GEMMA_API_URL}/chat/completions
#             key in Authorization: Bearer
#
# --- Option A: Google AI Studio (official, free Gemma tier) ---------------
# Key: https://aistudio.google.com/apikey
GEMMA_API_FLAVOR=google
GEMMA_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMMA_MODEL=gemma-3-27b-it
GEMMA_API_KEY=
#
# --- Option B: OpenRouter (works if AI Studio is unavailable) -------------
# Key: https://openrouter.ai/keys   Model page: /google/gemma-3-27b-it
# GEMMA_API_FLAVOR=openai
# GEMMA_API_URL=https://openrouter.ai/api/v1
# GEMMA_MODEL=google/gemma-3-27b-it
# GEMMA_API_KEY=sk-or-v1-...
#
# --- Option C: local Ollama (no key, no network, slower) ------------------
# `ollama pull gemma3:12b` first.
# GEMMA_API_FLAVOR=openai
# GEMMA_API_URL=http://localhost:11434/v1
# GEMMA_MODEL=gemma3:12b
# GEMMA_API_KEY=

# For a self-hosted OpenAI-compatible server that requires no API key:
# GEMMA_API_FLAVOR=openai
# GEMMA_API_URL=http://your-server:8049/v1
# GEMMA_MODEL=google/gemma-4-26B-A4B-it
# GEMMA_API_KEY=
# GEMMA_API_KEY_REQUIRED=false
# Default true: remote providers require a key unless explicitly disabled.

# Gemma's chat template has no system role. "merge" folds the system
# instructions into the first user turn and works on every provider; "system"
# sends a real system message. Leave as merge unless check_gemma.py says the
# provider honours the system role.
GEMMA_SYSTEM_ROLE_MODE=merge

# Generation. Low temperature because these are factual business questions.
GEMMA_TEMPERATURE=0.2
GEMMA_MAX_OUTPUT_TOKENS=1000
GEMMA_TIMEOUT_SECONDS=90
GEMMA_MAX_RETRIES=2

# Optional: path to a local Gemma `tokenizer.json` for exact token counts.
# Requires `pip install tokenizers`. Unset -> the built-in estimator is used.
# GEMMA_TOKENIZER_PATH=

# --- Token budget ----------------------------------------------------------
# The working context we allow ourselves per request. NOT the model's limit:
# Gemma 3 (4B/12B/27B) accepts 128k and Gemma 4 accepts 256k. 10,000 is the
# deliberate demo budget; the four components below are upper limits that
# rescale automatically if you lower the total.
GEMMA_CONTEXT_LIMIT=10000
TOKEN_BUDGET_KNOWLEDGE=7000
TOKEN_BUDGET_SYSTEM=1000
TOKEN_BUDGET_HISTORY=1000

# --- Chat guardrails -------------------------------------------------------
CHAT_MAX_QUESTION_CHARACTERS=2000
CHAT_HISTORY_TURNS=6
CHAT_RATE_LIMIT_PER_MINUTE=20
CHAT_RATE_LIMIT_PER_DAY=300
RETRIEVAL_MAX_SECTIONS=12

# ===========================================================================
# Phase 3 — public deployment
# ===========================================================================

# --- Where the public chatbot lives ---------------------------------------
# Every iframe URL and every install snippet is generated from this value, so
# it is the one place the deployment domain is written down. Production
# example: https://chat.skandaai.in
#
#   embed URL     {PUBLIC_WIDGET_BASE_URL}/embed/<public_id>
#   widget script {PUBLIC_WIDGET_BASE_URL}/w/<public_id>.js
#
# It must be HTTPS in production: browsers refuse to load an insecure iframe
# inside a secure page, so an http:// value means the widget simply does not
# appear on any real customer website.
PUBLIC_WIDGET_BASE_URL=http://localhost:3000

# Where this API is reachable from a visitor's browser. The embed page calls
# it directly, so it must be the public address and not an internal one.
PUBLIC_API_BASE_URL=http://localhost:8000

# --- Anonymous visitor sessions -------------------------------------------
# HMAC key for visitor session tokens. A visitor's session handle is the
# lookup key for their conversation, so this secret is what stops one visitor
# reading another's chat. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Leave it unset in development and a random per-process key is used, with a
# warning: sessions then break on restart and do not work across workers.
# Never commit a real value.
VISITOR_SESSION_SECRET=
VISITOR_SESSION_TTL_HOURS=24

# --- Public chat limits ----------------------------------------------------
# Tighter than the playground's, because this surface faces the open internet
# and every request costs model tokens. Per session, per chatbot, per IP.
PUBLIC_CHAT_RATE_LIMIT_PER_MINUTE=8
PUBLIC_CHAT_RATE_LIMIT_PER_DAY=100
PUBLIC_CHAT_CHATBOT_LIMIT_PER_MINUTE=30
PUBLIC_CHAT_CHATBOT_LIMIT_PER_DAY=500
PUBLIC_CHAT_IP_LIMIT_PER_MINUTE=20
PUBLIC_CHAT_MAX_MESSAGE_LENGTH=1000

# --- Publication gate ------------------------------------------------------
# For today's controlled demo, only these accounts may publish a chatbot to
# the public internet. Comma-separated email addresses, matched against the
# signed-in account. Leaving the list empty while approval is required blocks
# publishing for everyone, which check_setup.py reports as a failure.
#
# Set PUBLISH_REQUIRES_APPROVAL=false only once automated domain ownership
# verification exists: without it, any customer could publish a chatbot
# trained on a website they do not own.
PUBLISH_REQUIRES_APPROVAL=true
PUBLISH_ALLOWED_EMAILS=

# --- Floating launcher defaults (Phase 4 writes per-chatbot overrides) -----
# Starting points only. The customisation studio writes per-chatbot values
# into chatbots.deployment_config, which these back, so changing one here
# affects chatbots whose owner has not chosen for themselves.
#
# WIDGET_LAUNCHER_POSITION  bottom-right | bottom-left
# WIDGET_LAUNCHER_ICON      chat | robot | sparkle | support
# WIDGET_LAUNCHER_SHAPE     circle | rounded | square
# WIDGET_OPEN_ANIMATION     scale | slide | fade | none
# WIDGET_ACCENT_COLOR       a hex literal, nothing else: it is interpolated
#                           into generated CSS and into the loader script.
WIDGET_LAUNCHER_SIZE=56
WIDGET_LAUNCHER_POSITION=bottom-right
WIDGET_LAUNCHER_OFFSET=20
WIDGET_WINDOW_WIDTH=400
WIDGET_WINDOW_HEIGHT=600
WIDGET_LAUNCHER_ICON=chat
WIDGET_LAUNCHER_SHAPE=circle
WIDGET_OPEN_ANIMATION=scale
WIDGET_ACCENT_COLOR=#7d2a47

# Note on uploaded avatars and logos: there is nothing to configure. They are
# stored in PostgreSQL (migration 004) and served from PUBLIC_API_BASE_URL at
# /api/public/assets/<id>, so that value must be the address a visitor's
# browser can reach — and HTTPS in production, or browsers will block the
# images as mixed content on the customer's own site.

# --- Frontend / CORS -------------------------------------------------------
# PUBLIC_WIDGET_BASE_URL is added to the allowed origins automatically, since
# the embed page calls this API from the visitor's browser.
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Optional tuning -------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
# Demo guardrail: pages scraped per chatbot.
CRAWL_PAGE_LIMIT=20
CRAWL_MAX_DISCOVERY_DEPTH=3
# Give up on a crawl after this many seconds and keep whatever was stored.
CRAWL_MAX_DURATION_SECONDS=420
MAX_CHATBOTS_PER_USER=25
